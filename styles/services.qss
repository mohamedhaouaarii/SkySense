* { font-family: "Segoe UI"; font-size: 13px; color: #091b40; }
QWidget#servicesRoot, QWidget#servicesPage, QWidget#servicesContent { background: #f5f9ff; }
QLabel { background: transparent; border: none; }
QLabel[role="pageTitle"] { font-size: 34px; font-weight: 700; color: #080d2d; }
QLabel[role="subtitle"] { font-size: 16px; color: #5d77ad; }
QLabel[role="sectionTitle"] { font-size: 20px; font-weight: 700; color: #080d2d; }
QLabel[role="metricTitle"], QLabel[role="detailTitle"] { font-size: 14px; font-weight: 600; }
QLabel[role="number"] { font-size: 32px; font-weight: 700; color: #080d2d; }
QLabel[role="muted"], QLabel[role="smallMuted"] { color: #5d77ad; }
QLabel[role="smallMuted"] { font-size: 12px; }
QLabel[role="smallValue"] { font-size: 12px; color: #263b60; }
QLabel[role="recommendationCopy"] { font-size: 11px; color: #5d77ad; }
QLabel[role="trend"] { color: #00b45f; font-size: 11px; }
QLabel[role="trend"][tone="red"] { color: #ff304a; }
QLabel[role="trend"][tone="purple"] { color: #efa000; }
QLabel[role="topDate"] { font-size: 13px; }
QFrame[role="topbar"] { background: #fcfdff; border: none; border-bottom: 1px solid #e0ebf8; }
QFrame[role="divider"] { background: #d7e2f1; }
QFrame[role="card"], QFrame[role="metric"], QFrame[role="health"] { background: #ffffff; border: 1px solid #e0ebf8; border-radius: 12px; }
QFrame[role="metric"][tone="blue"] { background: #f2faff; }
QFrame[role="metric"][tone="green"] { background: #f2fcf7; }
QFrame[role="metric"][tone="red"] { background: #fff5f7; }
QFrame[role="metric"][tone="purple"] { background: #f7f5ff; }
QPushButton, QToolButton { background: #ffffff; border: 1px solid #d6e5f7; border-radius: 8px; padding: 0 14px; }
QPushButton:hover, QToolButton:hover { background: #eef6ff; border-color: #9bcaff; }
QPushButton:pressed, QToolButton:pressed { background: #dceeff; }
QPushButton:focus, QToolButton:focus { border-color: #0785ff; }
QPushButton[primary="true"] { color: #ffffff; background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #058aff,stop:1 #0065f2); border-color: #087aff; }
QPushButton[primary="true"]:hover { background: #168fff; }
QPushButton[primary="true"]:pressed { background: #005bc6; }
QPushButton[link="true"] { background: transparent; color: #0785ff; border: none; padding: 0 8px; }
QPushButton[nav="true"] { background: transparent; border: 1px solid transparent; color: #f1f7ff; text-align: left; padding: 0 16px; font-size: 16px; }
QPushButton[nav="true"]:hover { background: #163b5c; }
QPushButton[nav="true"][active="true"] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #079dff,stop:1 #0052cf); border: 1px solid #078dff; color: white; }
QLabel[role="sidebarStatus"] { font-size: 12px; color: #ffffff; }
QLabel[role="sidebarMuted"] { font-size: 11px; color: #bad0ea; }
QLabel[role="greenDot"], QLabel[role="doneDot"], QLabel[role="timelineDone"] { color: #00c778; }
QLabel[role="todoDot"], QLabel[role="timelinePending"] { color: #92a8c5; }
QLineEdit, QComboBox { background: #ffffff; border: 1px solid #d7e5f7; border-radius: 7px; padding: 0 12px; selection-background-color: #d6ecff; }
QLineEdit:focus, QComboBox:focus { border-color: #0785ff; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down { width: 22px; border: none; }
QComboBox::down-arrow { image: none; border: none; width: 0; height: 0; }
QComboBox QAbstractItemView { background: white; border: 1px solid #d7e5f7; selection-background-color: #e5f4ff; padding: 5px; }
QLabel[role="pill"] { border-radius: 14px; padding: 5px 11px; background: #dcfce7; color: #16a34a; }
QLabel[role="pill"][tone="blue"] { background: #e4f1ff; color: #1873d1; }
QTableWidget { background: white; border: 1px solid #e0ebf8; border-radius: 10px; }
QHeaderView::section { background: #ffffff; border: none; border-bottom: 1px solid #e0ebf8; padding-left: 10px; color: #17366f; font-size: 12px; font-weight: 600; }
QScrollArea { border: none; background: #f5f9ff; }
QScrollBar:vertical { width: 9px; background: #edf3fc; margin: 0; }
QScrollBar:horizontal { height: 10px; background: #edf3fc; margin: 0; }
QScrollBar::handle { background: #c1d3ea; border-radius: 4px; min-width: 25px; min-height: 25px; }
QScrollBar::handle:hover { background: #92b6e2; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QDialog#addServiceDialog { background: #ffffff; border: 1px solid #dce9f8; border-radius: 10px; }
QDialog#addServiceDialog QLineEdit, QDialog#addServiceDialog QComboBox, QDialog#addServiceDialog QDateEdit, QDialog#addServiceDialog QTimeEdit { min-height: 34px; }
QDialog#addServiceDialog QTextEdit { min-height: 56px; }
QLabel[role="dialogTitle"] { font-size: 22px; font-weight: 700; color: #102e5e; }
QLabel[role="dialogSubtitle"] { font-size: 13px; color: #5d77ad; }
QLabel[role="formSectionTitle"] { font-size: 13px; font-weight: 700; color: #102e5e; }
QLabel[role="fieldLabel"] { font-size: 12px; color: #25436e; }
QLabel[role="characterCount"] { font-size: 10px; color: #7890b5; }
QLabel[role="summaryStrong"] { font-size: 14px; font-weight: 700; color: #17366f; }
QLabel[role="summaryText"] { font-size: 13px; color: #315887; }
QLabel[role="dragHandle"] { color: #7290b8; font-size: 16px; }
QFrame[role="formSection"] { background: #ffffff; border: 1px solid #dce9f8; border-radius: 8px; }
QWidget[role="formSectionHeader"] { background: #eef7ff; border-top-left-radius: 8px; border-top-right-radius: 8px; }
QWidget#serviceSummary { background: #f3f9ff; border: 1px solid #cfe3fb; border-radius: 9px; }
QFrame[role="formSeparator"] { color: #cfe0f5; background: #cfe0f5; max-height: 1px; }
QWidget#formScroll { background: transparent; }
QTextEdit { background: white; border: 1px solid #d7e5f7; border-radius: 7px; padding: 8px; selection-background-color: #d6ecff; }
QTextEdit:focus { border-color: #0785ff; }
QLineEdit[readonly="true"] { background: #f4f8fd; color: #627b9d; }
QWidget[role="checklistRow"] { background: #ffffff; border: 1px solid #dce9f8; border-radius: 5px; }
QLineEdit[checklistInput="true"] { background: transparent; border: none; padding: 0 4px; font-size: 11px; }
QDialog#addServiceDialog QLineEdit[checklistInput="true"] { min-height: 22px; }
QLineEdit[checklistInput="true"]:focus { border: none; }
QPushButton#dialogClose { border: none; background: transparent; color: #5275a4; font-size: 25px; padding: 0; }
QPushButton#dialogClose:hover { background: #eaf4ff; border-radius: 17px; }
QPushButton#cancelService { min-width: 88px; min-height: 40px; color: #0877f9; }
QPushButton#createService { min-width: 132px; min-height: 40px; }
QPushButton[role="removeChecklist"] { border: none; background: transparent; padding: 0; color: #5175a4; }
QPushButton[role="removeChecklist"]:hover { color: #e34755; background: #fff0f2; }
